# Firebase Storage Security Rules — Trek Karakoram admin panel
#
# Deploy: Firebase Console → Storage → Rules → paste this file → Publish.
# Or with the Firebase CLI: firebase deploy --only storage
#
# Model:
#   • Anyone can READ uploaded images (so the website can display them).
#   • Only signed-in admins can UPLOAD / DELETE.
#   • Uploads limited to 10 MB images.

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
  }
}
